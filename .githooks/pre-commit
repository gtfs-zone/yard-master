#!/bin/sh
# Drift from the GTFS-realtime reference blocks a commit, and so does a spec
# that has drifted from cafe-car's accepted alert values. Both are fast and
# neither touches the network.
#
# vendor:check blocks on drift in a vendored file and warns when one is behind
# its upstream. Not --strict: a sibling committing upstream should not break a
# commit here, and the run exits 0 when no sibling is checked out.
#
# Enable with: git config core.hooksPath .githooks
set -e
pnpm run check-rt-spec
pnpm run check-alert-enums
pnpm run vendor:check
